#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

/ {
    behaviors {
        // Left-hand mods: only hold when a RIGHT-hand key is pressed
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_LEFT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;   // flow tap
            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 26 27 28 29 30 31 35 36 37>;
            hold-trigger-on-release;
            hold-while-undecided;            // speculative hold
            bindings = <&kp>, <&kp>;
        };

        // Right-hand mods: only hold when a LEFT-hand key is pressed
        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            label = "HRM_RIGHT";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <250>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <120>;   // flow tap
            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 25 32 33 34>;
            hold-trigger-on-release;
            hold-while-undecided;            // speculative hold
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            label = "Base";
            bindings = <
                        &kp Q        &kp W        &kp E         &kp R         &kp T                         &kp Y        &kp U         &kp I         &kp O        &kp P
                        &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F  &kp G                         &kp H        &hmr RCTRL J  &hmr RSHFT K  &hmr RALT L  &hmr RGUI SEMI
            &gresc      &kp Z        &kp X        &kp C         &kp V         &kp B                         &kp N        &kp M         &kp COMMA     &kp DOT      &kp SLASH     &kp SQT
                                                    &mo 1         &kp BSPC      &kp SPACE                     &kp ENTER    &kp TAB       &lt 2 DEL
            >;
        };

        Symbols {
            label = "Symbols";
            bindings = <
                        &kp EXCL     &kp AT       &kp HASH      &kp DLLR      &kp PRCNT                     &kp CARET    &kp AMPS      &kp STAR      &kp LPAR     &kp RPAR
                        &kp N0       &kp N1       &kp N2        &kp N3        &kp N4                        &kp MINUS    &hmr RCTRL EQUAL &hmr RSHFT BSLH &hmr RALT LBKT &hmr RGUI RBKT
            &kp DOT     &kp N5       &kp N6       &kp N7        &kp N8        &kp N9                        &kp UNDER    &kp PLUS      &kp PIPE      &kp LBRC     &kp RBRC      &kp GRAVE
                                                    &trans        &trans        &trans                        &trans       &trans        &trans
            >;
        };

        Fn {
            label = "Fn";
            bindings = <
                        &kp F1       &kp F2       &kp F3        &kp F4        &kp F5                        &kp F6       &kp F7        &kp F8        &kp F9       &kp F10
                        &bt BT_SEL 1 &kp C_PREV   &kp C_PP      &kp C_NEXT    &kp C_BRI_DN                  &kp LEFT     &kp DOWN      &kp UP        &kp RIGHT    &kp F11
            &bt BT_SEL 0 &bt BT_SEL 2 &kp C_VOL_DN &kp C_MUTE   &kp C_VOL_UP  &kp C_BRI_UP                  &trans       &trans        &trans        &trans       &trans        &kp F12
                                                    &trans        &trans        &trans                        &trans       &trans        &trans
            >;
        };
    };
};
